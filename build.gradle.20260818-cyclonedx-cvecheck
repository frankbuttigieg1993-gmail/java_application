import org.gradle.testing.jacoco.tasks.JacocoCoverageVerification
import org.gradle.testing.jacoco.tasks.JacocoReport
import org.cyclonedx.Version
import org.cyclonedx.gradle.CyclonedxDirectTask

plugins {
    id 'java'
    id 'org.springframework.boot' version '3.5.14'
    id 'io.spring.dependency-management' version '1.1.7'
    id 'jacoco'
    id 'org.sonarqube' version '7.2.3.7755'
    id 'project-report' 
    id 'org.cyclonedx.bom' version '3.3.0'
    id "org.owasp.dependencycheck" version "12.1.8"
}

group = 'com.example'
version = '1.0.0'
description = 'env-printer-springboot-project'

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(21)
    }
}

repositories {
    mavenCentral()
}

sonar {
    properties {
        def propertiesFile = project.file("sonar-project.properties")
        property "sonar.host.url", "http://10.0.2.15:9300"
        if (propertiesFile.exists()) {
            def props = new Properties()
            propertiesFile.withInputStream { props.load(it) }
        
            // Dynamically inject all properties into the Sonar configuration block
            props.each { key, value ->
                property key, value
            }
        }
    }
}

dependencies {
    implementation 'org.springframework.boot:spring-boot-starter-web'
    implementation 'org.springframework.boot:spring-boot-starter-actuator'
    implementation 'org.apache.commons:commons-lang3:3.14.0'
    testImplementation 'org.springframework.boot:spring-boot-starter-test'
    implementation 'org.apache.logging.log4j:log4j-core:2.14.1' // CVE-2021-4422
    implementation 'org.springframework:spring-beans:5.3.17' // CVE-2022-22965
    implementation 'com.fasterxml.jackson.core:jackson-databind:2.13.0' // CVE-2020-36518

}

tasks.named('test') {
    useJUnitPlatform()
    finalizedBy tasks.named('jacocoTestReport')
    // If you want the build to continue (not fail) even when tests fail, uncomment:
    // ignoreFailures = true
}

jacoco {
    toolVersion = '0.8.12'
}

tasks.named('jacocoTestReport') {
    // Do NOT dependOn('test') -> that creates a dependency cycle with finalizedBy.
    // Instead guarantee ordering:
    mustRunAfter tasks.named('test')
    reports {
        html.required = true
        xml.required = true
        csv.required = false
    }
}

dependencyCheck {
    // Generate both HTML (for humans) and JSON (for machines)
    formats = ['HTML', 'JSON']
    // Omitting scanConfigurations scans everything that could end up in Production but we are removing the test framework on purpose
    // scanConfigurations = ['runtimeClasspath', 'compileClasspath']
    skipConfigurations = ['testCompileClasspath', 'testRuntimeClasspath']
    outputDirectory = file("$buildDir/reports/dependency-check")
    data.directory = "${System.getProperty('user.home')}/.cache/dependency-check"
 
    // Fail the build if a CVSS score is 7.0 or higher
    // failBuildOnCVSS = 7.0F

    // Force scanning of all transitive dependencies across configuration scopes
    skipTestGroups = false 
    nvd {
        apiKey = '7d2c68c5-14d1-4201-98b2-9a745a84ff29'
    }
}

tasks.named('jacocoTestCoverageVerification') {
    // Remove dependsOn test to avoid the failure-short-circuit cycle.
    // Ensure it runs after the report so coverage data is available.
    mustRunAfter tasks.named('jacocoTestReport')
    // violationRules {
    //     rule {
    //         limit {
    //             minimum = 0.70
    //         }
    //     }
    // }
}

dependencyLocking {
    lockAllConfigurations()
}

/*
 * CycloneDX SBOM scopes
 * =====================
 *
 * This build produces three deliberately different SBOM views:
 *
 * 1) cyclonedxRuntimeBom
 *    - Scope: runtimeClasspath only.
 *    - Purpose: the clearest application/release SBOM; it represents the
 *      dependencies required when the application runs in production.
 *    - Build environment dependencies are NOT added.
 *   This is the main SBOM for what the deployed applicaiton needs to run
 *
 * 2) cyclonedxAllConfigsBom
 *    - Scope: all Gradle project configurations (includeConfigs = []).
 *    - Purpose: a broader project dependency inventory, including runtime,
 *      compile, test, development and other resolvable project configurations.
 *    - Build environment dependencies are NOT added.
 * This codes all components that are used by my application 
 *
 * 3) cyclonedxBuildEnvironmentBom
 *    - Scope: all Gradle project configurations PLUS the Gradle build
 *      environment (includeBuildEnvironment = true).
 *    - Purpose: the broadest CycloneDX view, adding dependencies used by the
 *      Gradle build environment/tooling to the all-configurations inventory.
 *    - IMPORTANT: this is NOT a "build-environment-only" SBOM; it contains the
 *      project configurations as well as the build environment.
 *
//  SBOM	                         What it represents
// runtime-bom	                     What the application needs at runtime
// all-configs-bom	                 Dependencies across all Gradle project configurations
// build-environment-bom             All project configurations plus Gradle build-environment dependencies

* For a security team asking, "What third-party components are part of this deployed application?", I'd generally give them runtime-bom.json.
* If they ask, "What dependencies does this application project use across development, compilation, testing and runtime?", then all-configs-bom.json is the better answer.
* And if they ask, "What dependencies are involved in the project and its Gradle build process?", that's what your third BOM is intended to capture.

 * Output directory:
 build/reports/cyclonedx/
├── runtime-bom.json
├── runtime-bom.xml
├── all-configs-bom.json
├── all-configs-bom.xml
├── build-environment-bom.json
└── build-environment-bom.xml
 */

/*
 * 1. Runtime application SBOM
  *
 * Represents dependencies used by the application at runtime. "what the deployed application needs to run.
 * Useful for:
 * - production dependency inventory
 * - licence reporting
 * - release/security reporting
 */
tasks.register('cyclonedxRuntimeBom', CyclonedxDirectTask) {
    group = 'cyclonedx'
    description = 'Generates a CycloneDX SBOM from runtimeClasspath only'

    schemaVersion = Version.VERSION_16
    projectType = 'application'

    includeConfigs = ['runtimeClasspath']
    includeBuildEnvironment = false

    includeLicenseText = true
    includeMetadataResolution = true

    jsonOutput = file("$buildDir/reports/cyclonedx/runtime-bom.json")
    xmlOutput = file("$buildDir/reports/cyclonedx/runtime-bom.xml")
}

/*
 * 2. All project configurations SBOM
 */
tasks.register('cyclonedxAllConfigsBom', CyclonedxDirectTask) {
    group = 'cyclonedx'
    description = 'Generates a CycloneDX SBOM from all Gradle project configurations'

    schemaVersion = Version.VERSION_16
    projectType = 'application'

    // An empty includeConfigs list means all project configurations.
    // Examples: 
//     runtimeClasspath
// compileClasspath
// testRuntimeClasspath
// testCompileClasspath
// annotationProcessor
// developmentOnly
    includeConfigs = []
    includeBuildEnvironment = false

    includeLicenseText = true
    includeMetadataResolution = true

    jsonOutput = file("$buildDir/reports/cyclonedx/all-configs-bom.json")
    xmlOutput = file("$buildDir/reports/cyclonedx/all-configs-bom.xml")
}

/*
 * 3. All project configurations + Gradle build environment SBOM
 */
tasks.register('cyclonedxBuildEnvironmentBom', CyclonedxDirectTask) {
    group = 'cyclonedx'
    description = 'Generates a CycloneDX SBOM from all project configurations plus the Gradle build environment'

    schemaVersion = Version.VERSION_16
    projectType = 'application'

    includeConfigs = []
    includeBuildEnvironment = true

    includeLicenseText = true
    includeMetadataResolution = true

    // Explicitly configure the output properties as files.
    jsonOutput.set(file("$buildDir/reports/cyclonedx/build-environment-bom.json"))
    xmlOutput.set(file("$buildDir/reports/cyclonedx/build-environment-bom.xml"))
}

// Generate all three SBOM views as part of the normal Gradle verification lifecycle.
check.dependsOn tasks.named('cyclonedxRuntimeBom')
check.dependsOn tasks.named('cyclonedxAllConfigsBom')
check.dependsOn tasks.named('cyclonedxBuildEnvironmentBom')

/*
 * Runtime SBOM vulnerability policy gate
 * ======================================
 * This task does not perform vulnerability matching itself. Trivy remains the
 * vulnerability authority. It evaluates the JSON produced by the Trivy SBOM
 * scan and fails when a reported vulnerability has a CVSS score >= 6.0.
 *
 * Score policy:
 * 1. Prefer the CVSS entry matching Trivy's SeveritySource when that entry has
 *    a numeric V4Score/V3Score/V2Score.
 * 2. Otherwise use the highest numeric CVSS score Trivy reported for the CVE.
 * 3. Findings with no numeric CVSS score are reported but do not fail this gate.
 *
 * Override the threshold with -PsbomCvssThreshold=<score> if required.
 */
def sbomCvssThresholdProvider = providers.gradleProperty('sbomCvssThreshold')
    .orElse('6.0')

tasks.register('verifyRuntimeSbomVulnerabilities') {
    group = 'verification'
    description = 'Fails when Trivy reports a runtime SBOM vulnerability with CVSS >= the configured threshold (default 6.0)'

    def trivyReport = layout.buildDirectory.file('reports/cyclonedx/trivy-runtime-bom.json')
    def policyReport = layout.buildDirectory.file('reports/cyclonedx/runtime-vulnerability-policy.md')

    inputs.file(trivyReport)
    inputs.property('cvssThreshold', sbomCvssThresholdProvider)
    outputs.file(policyReport)

    // Resolve the threshold during configuration rather than reaching back
    // into the Project from the execution-time doLast closure.
    def threshold = sbomCvssThresholdProvider.get().toBigDecimal()

    doLast {
        def reportFile = trivyReport.get().asFile
        def summaryFile = policyReport.get().asFile
        summaryFile.parentFile.mkdirs()

        if (!reportFile.exists()) {
            summaryFile.text = '''## Runtime SBOM Vulnerability Policy

**Result:** ERROR

The Trivy runtime SBOM report was not found.
'''
            throw new GradleException("Trivy runtime SBOM report not found: ${reportFile}. Run the Trivy SBOM scan before this task.")
        }

        def report = new groovy.json.JsonSlurper().parse(reportFile)
        def violations = []
        def unscored = []

        (report.Results ?: []).each { result ->
            (result.Vulnerabilities ?: []).each { vuln ->
                def cvss = vuln.CVSS instanceof Map ? vuln.CVSS : [:]
                def severitySource = vuln.SeveritySource?.toString()
                def preferred = severitySource ? cvss[severitySource] : null

                def scoreFrom = { entry ->
                    if (!(entry instanceof Map)) return null
                    for (field in ['V4Score', 'V3Score', 'V2Score']) {
                        def value = entry[field]
                        if (value instanceof Number) return new BigDecimal(value.toString())
                        if (value != null && value.toString().isNumber()) return new BigDecimal(value.toString())
                    }
                    return null
                }

                def selectedScore = scoreFrom(preferred)
                def selectedSource = selectedScore != null ? severitySource : null

                if (selectedScore == null) {
                    cvss.each { source, entry ->
                        def candidate = scoreFrom(entry)
                        if (candidate != null && (selectedScore == null || candidate > selectedScore)) {
                            selectedScore = candidate
                            selectedSource = source.toString()
                        }
                    }
                }

                def finding = [
                    component: vuln.PkgName ?: vuln.PkgID ?: result.Target ?: 'unknown',
                    installed: vuln.InstalledVersion ?: 'unknown',
                    vulnerability: vuln.VulnerabilityID ?: 'unknown',
                    score: selectedScore,
                    source: selectedSource ?: 'none',
                    severity: vuln.Severity ?: 'UNKNOWN',
                    fixed: vuln.FixedVersion ?: 'not available'
                ]

                if (selectedScore == null) {
                    unscored << finding
                } else if (selectedScore >= threshold) {
                    violations << finding
                }
            }
        }

        if (!unscored.isEmpty()) {
            logger.warn("${unscored.size()} Trivy vulnerability finding(s) had no numeric CVSS score and were not used to fail the CVSS gate.")
        }

        violations.sort { a, b -> b.score <=> a.score }

        if (!violations.isEmpty()) {
            logger.error('Runtime SBOM vulnerability policy violations:')
            logger.error(String.format('%-42s %-20s %-18s %-8s %-6s %-12s %s',
                'COMPONENT', 'INSTALLED', 'CVE', 'SEVERITY', 'CVSS', 'SOURCE', 'FIXED'))
            logger.error('-' * 135)
            violations.each { v ->
                logger.error(String.format('%-42s %-20s %-18s %-8s %-6s %-12s %s',
                    v.component.take(42), v.installed.take(20), v.vulnerability.take(18),
                    v.severity.take(8), v.score.toPlainString(), v.source.take(12), v.fixed))
            }
        }

        // Always create the Markdown report before failing the task so the
        // composite action can append it to $GITHUB_STEP_SUMMARY.
        def escapeMarkdown = { value ->
            (value ?: '').toString().replace('|', '\\|').replace('\r', ' ').replace('\n', ' ')
        }

        def md = new StringBuilder()
        md << '## Runtime SBOM Vulnerability Policy\n\n'
        md << "**Result:** ${violations.isEmpty() ? 'PASS' : 'FAIL'}  \n"
        md << "**Threshold:** CVSS >= ${threshold}  \n"
        md << "**Violations:** ${violations.size()}  \n"
        md << "**Unscored findings:** ${unscored.size()}\n\n"

        if (!violations.isEmpty()) {
            md << '| Component | Version | Vulnerability | Severity | CVSS | CVSS Source | Fixed Version |\n'
            md << '|---|---|---|---|---:|---|---|\n'
            violations.each { v ->
                md << "| ${escapeMarkdown(v.component)} | ${escapeMarkdown(v.installed)} | ${escapeMarkdown(v.vulnerability)} | ${escapeMarkdown(v.severity)} | ${v.score.toPlainString()} | ${escapeMarkdown(v.source)} | ${escapeMarkdown(v.fixed)} |\n"
            }
        } else {
            md << "No Trivy vulnerability with a numeric CVSS score at or above ${threshold} was found.\n"
        }

        if (!unscored.isEmpty()) {
            md << "\n> Note: ${unscored.size()} Trivy vulnerability finding(s) had no numeric CVSS score and were not used to fail this CVSS-based gate.\n"
        }

        summaryFile.text = md.toString()
        logger.lifecycle("GitHub summary report written to: ${summaryFile}")

        if (!violations.isEmpty()) {
            throw new GradleException("Runtime SBOM vulnerability policy failed: ${violations.size()} finding(s) have CVSS >= ${threshold}.")
        }

        logger.lifecycle("Runtime SBOM vulnerability policy passed: no Trivy finding has CVSS >= ${threshold}.")
    }
}
